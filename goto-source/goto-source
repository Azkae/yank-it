#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["click"]
# ///

import re
import subprocess
import sys
from pathlib import Path

import click


def parse_path(selector: str) -> list[dict]:
    segments = []
    for part in selector.split(" > "):
        part = part.strip()
        if part.startswith("[") and part.endswith("]"):
            segments.append({"type": "component", "name": part[1:-1]})
        else:
            dot_parts = part.split(".")
            segments.append({
                "type": "element",
                "tag": dot_parts[0],
                "classes": dot_parts[1:],
            })
    return segments


def find_component_files(project_root: Path, component_name: str) -> list[str]:
    pattern = rf"(?:function|const|class)\s+{re.escape(component_name)}[\s(<]"
    result = subprocess.run(
        [
            "rg", "-l", pattern,
            "--glob", "*.tsx", "--glob", "*.jsx", "--glob", "*.ts", "--glob", "*.js",
            "--glob", "!node_modules", "--glob", "!dist", "--glob", "!build", "--glob", "!.git",
            str(project_root),
        ],
        capture_output=True, text=True,
    )
    return result.stdout.strip().splitlines() if result.stdout.strip() else []


def all_jsx_files(project_root: Path) -> list[str]:
    result = subprocess.run(
        [
            "rg", "--files",
            "--glob", "*.tsx", "--glob", "*.jsx",
            "--glob", "!node_modules", "--glob", "!dist", "--glob", "!build", "--glob", "!.git",
            str(project_root),
        ],
        capture_output=True, text=True,
    )
    return result.stdout.strip().splitlines() if result.stdout.strip() else []


def find_element_in_files(files: list[str], tag: str, classes: list[str], project_root: Path) -> list[str]:
    if not files:
        return []

    results = set()

    for class_name in classes:
        # Inline string className: <tag ... className="...classname..."
        inline_pattern = rf"<{re.escape(tag)}[^>]*className=[\"'`{{][^\"'`}}]*{re.escape(class_name)}"
        # CSS modules: <tag ... className={styles.classname}
        modules_pattern = rf"<{re.escape(tag)}[^>]*className=\{{[^}}]*\.{re.escape(class_name)}"
        # Multiline: <tag\n  className="classname" (up to 5 lines)
        multiline_pattern = (
            rf"<{re.escape(tag)}(?:[^>]|\n)*?className=[\"'`{{][^\"'`}}]*{re.escape(class_name)}"
        )

        for pattern, extra_args, only_tag_lines in [
            (inline_pattern, [], False),
            (modules_pattern, [], False),
            (multiline_pattern, ["-U"], True),  # multiline spans lines; keep only the <tag line
        ]:
            cmd = ["rg", "-n", "--no-heading", "--with-filename"] + extra_args + [pattern] + files
            result = subprocess.run(cmd, capture_output=True, text=True)
            for line in result.stdout.splitlines():
                # format: path:line_number:content
                parts = line.split(":", 2)
                if len(parts) < 3:
                    continue
                file_path, line_no, content = parts
                if only_tag_lines and f"<{tag}" not in content:
                    continue
                try:
                    rel = Path(file_path).relative_to(project_root)
                except ValueError:
                    rel = Path(file_path)
                results.add(f"{rel}:{line_no}")

    return sorted(results)


@click.command()
@click.argument("selector")
@click.argument("project_root", default=".", type=click.Path(exists=True, file_okay=False))
def main(selector: str, project_root: str):
    """Find the source location of a JSX element from a chrome-copy-dom selector path."""
    root = Path(project_root).resolve()
    segments = parse_path(selector)

    # Find the target element (last segment)
    if not segments or segments[-1]["type"] != "element":
        click.echo("Error: selector must end with an HTML element (e.g. p.taskSummary)", err=True)
        sys.exit(1)

    target = segments[-1]
    tag = target["tag"]
    classes = target["classes"]

    # Find nearest component ancestor
    component_name = None
    for seg in reversed(segments[:-1]):
        if seg["type"] == "component":
            component_name = seg["name"]
            break

    # Find candidate files
    if component_name:
        files = find_component_files(root, component_name)
        if not files:
            click.echo(
                f"No files found for component '{component_name}', searching all JSX/TSX files...",
                err=True,
            )
            files = all_jsx_files(root)
    else:
        files = all_jsx_files(root)

    if not files:
        click.echo("No JSX/TSX files found in project.", err=True)
        sys.exit(1)

    matches = find_element_in_files(files, tag, classes, root)

    if not matches:
        desc = f"<{tag}> with class(es) {classes}"
        click.echo(f"No matches found for {desc}", err=True)
        sys.exit(1)

    for match in matches:
        click.echo(match)


if __name__ == "__main__":
    main()
