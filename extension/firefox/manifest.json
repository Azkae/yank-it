{
  "manifest_version": 3,
  "name": "Yank It",
  "version": "1.0",
  "description": "Click an element to copy its CSS selector path to the clipboard",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["http://localhost:30142/*"],
  "action": {
    "default_icon": {
      "128": "src/icon.png"
    },
    "default_title": "Pick an element to copy its selector"
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  }
}
